<Window x:Class="_10._03._2026_slepa_mapa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slepá mapa" Height="500" Width="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Background="#F0F0F0" Orientation="Horizontal">
            <TextBlock Name="TxtTarget" FontSize="20" Margin="10" FontWeight="Bold"/>
            <TextBlock Name="TxtScore" FontSize="16" Margin="10" VerticalAlignment="Center"/>
        </StackPanel>

        <Viewbox Grid.Row="1">
            <Grid>
                <Image Name="MapImage"
                   Source="img/czechia.png"
                   Stretch="Uniform"
                   SizeChanged="MapImage_SizeChanged"
                   MouseLeftButtonDown="MapImage_MouseLeftButtonDown"/>  
                <Canvas Name="OverlayCanvas" IsHitTestVisible="True"/>
            </Grid>
        </Viewbox>
    </Grid>
</Window>